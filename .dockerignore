# Ignore version control
.git

# Ignore local build artifacts
bin/
tmp/
main

# Ignore environment files (Security risk!)
.env
.env.local

# Ignore OS files
.DS_Store

# Ignore dependencies (re-downloaded inside Docker)
node_modules/
vendor/

# Docker secrets
docker/secrets/*.txt

# CSS output (generated file)
web/static/css/output.css

# Templ generated files
**/*_templ.go
