package legal

templ Privacy() {
    @Layout("Privacy Policy", "January 12, 2026") {

        <p class="lead">
            At Dividr, we take your privacy seriously. This policy explains how we handle your data, specifically regarding the HMRC Making Tax Digital (MTD) submission process.
        </p>

        <h3>1. Data Collection</h3>
        <p>
            We collect your email address for account management and waitlist notification purposes. When you upload a spreadsheet for processing, that file is transmitted securely to our servers.
        </p>

        <h3>2. Data Retention (The "Zero Retention" Policy)</h3>
        <p>
            We adhere to a strict zero-retention policy for financial data:
        </p>
        <ul>
            <li><strong>Spreadsheets:</strong> Uploaded files are held in memory only for the duration of the parsing and submission process.</li>
            <li><strong>Submission Data:</strong> Once HMRC confirms receipt, we delete the transaction data from our servers within 24 hours.</li>
            <li><strong>Logs:</strong> We retain only the submission receipt ID and timestamp for audit purposes.</li>
        </ul>

        <h3>3. Third Parties</h3>
        <p>
            We do not sell your data. We share data only with:
        </p>
        <ul>
            <li><strong>HMRC:</strong> To fulfill the MTD submission request you initiated.</li>
            <li><strong>Infrastructure Providers:</strong> Our servers are hosted on AWS (London Region).</li>
        </ul>

        <h3>4. Contact Us</h3>
        <p>
            If you have questions about this policy, please contact support@dividr.app.
        </p>
    }
}
