package pages

import (
	"github.com/rhysmcneill/dividr/web/templates/layouts"
	"github.com/rhysmcneill/dividr/web/templates/components"
)

templ Landing() {
	@layouts.Base("Welcome") {
		<div class="relative isolate px-6 pt-14 lg:px-8">
			<div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-56 text-center">
				<h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">
					Split your income. File quarterly. Stress less.
				</h1>
				<p class="mt-6 text-lg leading-8 text-gray-600">
                    Dividr helps sole traders, freelancers and property landlords submit their taxes quarterly with ease.
				</p>
				<div class="mt-10 flex items-center justify-center gap-x-6">
					// Link to the dashboard
					<a href="/signup">
						@components.Button("Get Started", nil, true)
					</a>

					// Sign up link
					<a href="/signin">
						@components.Button("Sign in", nil, false)
					</a>
				</div>
			</div>
		</div>
	}
}
