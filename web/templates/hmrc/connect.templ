package hmrc

import (
    "github.com/rhysmcneill/dividr/web/templates/shared"
    "github.com/rhysmcneill/dividr/web/templates/components"
)

templ ConnectPage(errStr string) {
    @shared.Base("Connect HMRC", true) {
        <div class="flex flex-col flex-grow justify-center px-6 py-12 lg:px-8 relative isolate min-h-[80vh]">

            // --- Background Glow (Identical to Login) ---
            <div class="absolute inset-0 -z-10 overflow-hidden">
                <div class="absolute left-[calc(50%-10rem)] top-[-5rem] h-[20rem] w-[20rem] sm:left-[calc(50%-11rem)] sm:top-[-10rem] sm:h-[50rem] sm:w-[50rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#0284c7] to-[#2563eb] opacity-15 blur-[60px] sm:blur-[100px]"></div>
            </div>

            <div class="sm:mx-auto sm:w-full sm:max-w-md">
                // SVG Icon
                <div class="mx-auto h-12 w-12 flex items-center justify-center rounded-xl bg-blue-500/10 ring-1 ring-blue-500/20">
                     <svg class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                    </svg>
                </div>
                <h2 class="mt-6 text-center text-2xl font-bold leading-9 tracking-tight text-white">Link your Tax Account</h2>
                <p class="mt-2 text-center text-sm text-zinc-400">
                    We need your tax identifiers to securely link with HMRC.
                </p>
            </div>

            <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-md">
                // Glass Card Container
                <div class="bg-zinc-900/50 py-8 px-4 shadow-xl ring-1 ring-white/10 sm:rounded-xl sm:px-10 backdrop-blur-md">
                    <form class="space-y-6" action="/auth/hmrc/details" method="POST">

                        // Error Banner (Dark Mode Style)
                        if errStr != "" {
                            <div class="rounded-md bg-red-500/10 border border-red-500/20 p-4 mb-4">
                                <div class="flex">
                                    <div class="flex-shrink-0">
                                        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                    <div class="ml-3">
                                        <h3 class="text-sm font-medium text-red-400">{ errStr }</h3>
                                    </div>
                                </div>
                            </div>
                        }

                        <div>
                            <label for="nino" class="block text-sm font-medium leading-6 text-zinc-300">National Insurance Number</label>
                            <div class="mt-2">
                                <input
                                    id="nino"
                                    name="nino"
                                    type="text"
                                    required
                                    placeholder="QQ 12 34 56 C"
                                    class="block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:text-sm sm:leading-6 placeholder:text-zinc-500"
                                />
                            </div>
                        </div>

                        <div>
                            <label for="mtd_id" class="block text-sm font-medium leading-6 text-zinc-300">MTD Income Tax ID</label>
                            <div class="mt-2">
                                <input
                                    id="mtd_id"
                                    name="mtd_id"
                                    type="text"
                                    required
                                    placeholder="XPIT00..."
                                    class="block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:text-sm sm:leading-6 placeholder:text-zinc-500"
                                />
                            </div>
                            <p class="mt-2 text-xs text-zinc-500">Found on your HMRC enrollment letter or email.</p>
                        </div>

                        <div>
                            @components.Button("Continue to HMRC", templ.Attributes{
                                "type": "submit",
                                "class": "w-full rounded-md bg-blue-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors",
                            }, true)
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
