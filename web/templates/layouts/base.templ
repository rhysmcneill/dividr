package layouts

// Base layout accepts a title and the content to render inside
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-gray-50">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } | Dividr</title>

			<link href="/static/css/output.css" rel="stylesheet"/>

			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body class="h-full flex flex-col font-sans antialiased text-gray-900">
			<header class="bg-white shadow-sm">
				<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8 flex justify-between items-center">
					<a href="/" class="text-xl font-bold text-indigo-600">Dividr</a>
					<nav class="space-x-4">
						<a href="/app/dashboard" class="text-gray-600 hover:text-gray-900">Dashboard</a>
					</nav>
				</div>
			</header>

			<main class="flex-grow">
				{ children... }
			</main>

			<footer class="bg-gray-100 mt-auto border-t border-gray-200">
				<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 text-center text-gray-500 text-sm">
					&copy; 2026 Dividr. All rights reserved.
				</div>
			</footer>
		</body>
	</html>
}
