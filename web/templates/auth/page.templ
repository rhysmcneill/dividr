package auth

import (
    "github.com/rhysmcneill/dividr/web/templates/shared"
    "github.com/rhysmcneill/dividr/web/templates/components"
)

templ Login() {
    @shared.Base("Log In", false) {
        <div class="flex flex-col flex-grow justify-center px-6 py-12 pt-24 lg:px-8 relative isolate">

            // --- Background Glow (Refined for Mobile) ---
            <div class="absolute inset-0 -z-10 overflow-hidden">
                <div class="absolute left-[calc(50%-10rem)] top-[-5rem] h-[20rem] w-[20rem] sm:left-[calc(50%-11rem)] sm:top-[-10rem] sm:h-[50rem] sm:w-[50rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#0284c7] to-[#2563eb] opacity-15 blur-[60px] sm:blur-[100px]"></div>
            </div>

            <div class="sm:mx-auto sm:w-full sm:max-w-sm">
                <h2 class="mt-10 text-center text-2xl font-bold leading-9 tracking-tight text-white">Sign in to your account</h2>
            </div>

            <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
                <form class="space-y-6" action="/login" method="POST">
                    <div>
                        <label for="email" class="block text-sm font-medium leading-6 text-zinc-300">Email address</label>
                        <div class="mt-2">
                            <input
                                id="email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                required
                                class="block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:text-sm sm:leading-6 placeholder:text-zinc-500"
                            />
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between">
                            <label for="password" class="block text-sm font-medium leading-6 text-zinc-300">Password</label>
                            <div class="text-sm">
                                <a href="#" class="font-semibold text-blue-400 hover:text-blue-300">Forgot password?</a>
                            </div>
                        </div>
                        <div class="mt-2">
                            <input
                                id="password"
                                name="password"
                                type="password"
                                autocomplete="current-password"
                                required
                                class="block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:text-sm sm:leading-6 placeholder:text-zinc-500"
                            />
                        </div>
                    </div>

                    <div>
                        @components.Button("Sign in", templ.Attributes{
                            "type": "submit",
                            "class": "w-full rounded-md bg-blue-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors",
                        }, true)
                    </div>
                </form>

                <p class="mt-10 text-center text-sm text-zinc-400">
                    Not a member?
                    <a href="/signup" class="font-semibold leading-6 text-blue-400 hover:text-blue-300">Start a 14 day free trial</a>
                </p>
            </div>
        </div>
    }
}

templ Signup() {
    @shared.Base("Sign Up", false) {
        <div class="flex flex-col flex-grow justify-center px-6 py-12 pt-24 lg:px-8 relative isolate">

            // --- Background Glow (Refined for Mobile) ---
            <div class="absolute inset-0 -z-10 overflow-hidden">
                <div class="absolute left-[calc(50%)] top-[-5rem] h-[20rem] w-[20rem] sm:left-[calc(50%+11rem)] sm:top-[-10rem] sm:h-[50rem] sm:w-[50rem] -translate-x-1/2 rotate-[-30deg] bg-gradient-to-tr from-[#0284c7] to-[#2563eb] opacity-15 blur-[60px] sm:blur-[100px]"></div>
            </div>

            <div class="sm:mx-auto sm:w-full sm:max-w-sm">
                <h2 class="mt-10 text-center text-2xl font-bold leading-9 tracking-tight text-white">Create your account</h2>
            </div>

            <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
                <form class="space-y-6" action="/signup" method="POST">
                    <div>
                        <label for="email" class="block text-sm font-medium leading-6 text-zinc-300">Email address</label>
                        <div class="mt-2">
                            <input
                                id="email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                required
                                class="block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:text-sm sm:leading-6 placeholder:text-zinc-500"
                            />
                        </div>
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-medium leading-6 text-zinc-300">Password</label>
                        <div class="mt-2">
                            <input
                                id="password"
                                name="password"
                                type="password"
                                autocomplete="new-password"
                                required
                                class="block w-full rounded-md border-0 bg-white/5 py-1.5 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-blue-500 sm:text-sm sm:leading-6 placeholder:text-zinc-500"
                            />
                        </div>
                    </div>

                    <div>
                         @components.Button("Sign up", templ.Attributes{
                            "type": "submit",
                            "class": "w-full rounded-md bg-blue-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors",
                        }, true)
                    </div>
                </form>

                 <p class="mt-10 text-center text-sm text-zinc-400">
                    Already have an account?
                    <a href="/login" class="font-semibold leading-6 text-blue-400 hover:text-blue-300">Log In</a>
                </p>
            </div>
        </div>
    }
}
